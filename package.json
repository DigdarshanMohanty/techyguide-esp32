{
  "name": "hello-world",
  "version": "1.0.0",
  "description": "A sample app using Blockly",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "node scripts/audit-generators.js",
    "audit": "node scripts/audit-generators.js",
    "audit:watch": "nodemon --watch src/generators --ext js --exec 'node scripts/audit-generators.js'",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "compile-server": "node compile-server.js",
    "start": "concurrently \"npm run dev\" \"npm run compile-server\""
  },
  "keywords": [
    "blockly"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "css-loader": "^6.7.1",
    "dotenv-webpack": "^9.0.0",
    "html-webpack-plugin": "^5.5.0",
    "nodemon": "^3.1.14",
    "source-map-loader": "^4.0.1",
    "style-loader": "^3.3.1",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "blockly": "^12.0.0",
    "cors": "^2.8.6",
    "esptool-js": "^0.6.0",
    "lucide": "^1.9.0",
    "pixi.js": "^8.17.1",
    "tailwindcss": "^4.2.4"
  }
}
